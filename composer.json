{
    "name": "carropublic/carromessenger",
    "description": ":package_description",
    "license": "MIT",
    "authors": [
        {
            "name": "Aung Ko Ko",
            "email": "aung.koko@carro.co"
        }
    ],
    "homepage": "https://github.com/carropublic/carromessenger",
    "keywords": ["Laravel", "CarroMessenger"],
    "require": {
        "illuminate/support": "~5|~6|~7|~8|~9|~10|~11|~12"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "messagebird/php-rest-api": "^1.19",
        "twilio/sdk": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "CarroPublic\\CarroMessenger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CarroPublic\\CarroMessenger\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CarroPublic\\CarroMessenger\\CarroMessengerServiceProvider"
            ],
            "aliases": {
                "CarroMessenger": "CarroPublic\\CarroMessenger\\Facades\\CarroMessenger"
            }
        }
    }
}
